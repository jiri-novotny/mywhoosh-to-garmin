# MyWhoosh Credentials
MYWHOOSH_EMAIL=your_email@example.com
MYWHOOSH_PASSWORD=your_password

# Garmin Connect Credentials
GARMIN_USERNAME=your_garmin_username
GARMIN_PASSWORD=your_garmin_password

# Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Serial number of your Garmin device (written into the FIT file).
# Leave empty to keep the serial from the original MyWhoosh file.
GARMIN_DEVICE_SERIAL=
